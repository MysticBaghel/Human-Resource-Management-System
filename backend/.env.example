# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Local development only: create the role and database first (see README).
# Leave it unset to fall back to a local SQLite file, which is handy for a quick start.
DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms

# Origins allowed to send unsafe requests with the CSRF cookie.
# The Vite dev server proxies /api to Django, so the browser only ever sees :5173.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where password-reset emails send the user.
FRONTEND_URL=http://localhost:5173

# Note: VITE_API_PROXY_TARGET is a *frontend* variable. Set it in the shell or
# an env file under frontend/, because Vite only reads env from its own cwd.
