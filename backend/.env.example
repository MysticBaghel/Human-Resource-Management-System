# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Local development only: create the role and database first (see README).
# Leave it unset to fall back to a local SQLite file, which is handy for a quick start.
DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms

# Origins allowed to send unsafe requests with the CSRF cookie.
# The Vite dev server proxies /api to Django, so the browser only ever sees :5173.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where password-reset emails send the user.
FRONTEND_URL=http://localhost:5173

# Company name on generated payslips and invoices. A CompanyProfile in the
# Django admin overrides this and also supplies the logo.
PAYROLL_COMPANY_NAME=HRMS

# Invoice defaults.
INVOICE_DEFAULT_CURRENCY=INR
INVOICE_REMINDER_COOLDOWN_DAYS=3
DEFAULT_FROM_EMAIL=hrms@localhost

# Gmail API sending with OAuth 2.0. Run
#   python manage.py gmail_oauth_setup
# to obtain GMAIL_REFRESH_TOKEN, then set all four values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=HRMS
# Development/test only: use Django's email backend when Gmail is not set up.
# Leave false in production; dev.py enables it automatically for local use.
INVOICE_EMAIL_FALLBACK=False

# Note: VITE_API_PROXY_TARGET is a *frontend* variable. Set it in the shell or
# an env file under frontend/, because Vite only reads env from its own cwd.
